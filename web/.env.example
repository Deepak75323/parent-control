# Leave empty for same-origin (Oracle /portal) or local Vite proxy.
VITE_API_BASE_URL=
VITE_WS_URL=

# Opt-in Airtel-style AES body encryption (must match backend).
# Default false — existing mobile apps send plaintext.
VITE_API_PAYLOAD_ENCRYPTION_ENABLED=false
VITE_API_PAYLOAD_ENCRYPTION_KEY=
VITE_API_PAYLOAD_ENCRYPTION_IV=

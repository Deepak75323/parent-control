<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds: allow HTTP to any host on local dev networks (USB reverse, LAN, emulator). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Production/main: HTTPS only. Cleartext for local dev lives in src/debug/res/xml only.
  Release overlay adds certificate pinning (src/release/res/xml/network_security_config.xml).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tamperTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/tamper_gate_title_pin"
            android:textColor="#0f172a"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tamperModeLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tamper_gate_use_code"
            android:textColor="#7c3aed"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tamperFieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/tamper_gate_pin_label"
            android:textColor="#334155"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/tamperInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="@string/tamper_gate_hint"
            android:inputType="numberPassword"
            android:padding="14dp"
            android:textColor="#0f172a"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tamperInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#ede9fe"
            android:padding="14dp"
            android:text="@string/tamper_gate_info_code"
            android:textColor="#5b21b6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tamperStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#b91c1c"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTamperOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#a78bfa"
            android:text="@string/tamper_gate_ok"
            android:textAllCaps="true" />

        <Button
            android:id="@+id/btnTamperRequestCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tamper_gate_get_code"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnTamperHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="@string/tamper_gate_home"
            android:textColor="#7c3aed"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

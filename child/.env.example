# Child app environment template — copy to child/.env
# Only public-safe / local-dev values belong here. Never commit real secrets.

API_BASE_URL=http://10.0.2.2:8080
DEV_LAN_HOST=192.168.1.5
ENABLE_SSL_PINNING=false

# API payload AES-CBC (same values as backend API_PAYLOAD_ENCRYPTION_*). Leave empty to disable.
API_PAYLOAD_ENCRYPTION_KEY=
API_PAYLOAD_ENCRYPTION_IV=

# Dev-only tamper bypass PIN — leave empty for release builds.
# Also export when building Android: TAMPER_MASTER_PIN=... ./gradlew assembleDebug
TAMPER_MASTER_PIN=

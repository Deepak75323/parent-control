# Copy to .env for local development (Podman compose reads root .env via scripts/dev/compose.sh)

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parental_control
SPRING_DATASOURCE_USERNAME=pcp
SPRING_DATASOURCE_PASSWORD=pcp_secret
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=change-me-in-production-use-256-bit-minimum-secret-key!!
HMAC_REQUIRED=false
RATE_LIMIT_ENABLED=true
BILLING_ENFORCEMENT=false
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_ENCRYPTION_ENABLED=false
APP_ENCRYPTION_KEY=dev-only-change-in-production-32chars!!
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_FAMILY=
SERVER_PORT=8080
# Metered TURN — https://www.metered.ca (TURN Server → credentials)
TURN_USERNAME=
TURN_CREDENTIAL=

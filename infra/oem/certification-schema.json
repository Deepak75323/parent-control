{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OEM Device Certification Report",
  "type": "object",
  "required": ["vendor", "runId", "summary", "scenarios"],
  "properties": {
    "vendor": { "type": "string" },
    "deviceId": { "type": "string" },
    "runId": { "type": "string" },
    "androidVersion": { "type": "string" },
    "sdkInt": { "type": "integer" },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "manual": { "type": "integer" },
        "certificationScore": { "type": "number" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "SKIP", "MANUAL"] },
          "mttrSeconds": { "type": "integer" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}

{
  "title": "PCP Platform Overview",
  "uid": "pcp-platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Devices Online",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "device_online_count", "legendFormat": "online"}]
    },
    {
      "type": "stat",
      "title": "Devices Offline",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "device_offline_count", "legendFormat": "offline"}]
    },
    {
      "type": "stat",
      "title": "Active Streams",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "stream_active_sessions", "legendFormat": "active"}]
    },
    {
      "type": "stat",
      "title": "Suspicious Devices",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "device_suspicious_count", "legendFormat": "suspicious"}]
    },
    {
      "type": "timeseries",
      "title": "Command Throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(rate(command_sent_total[5m]))", "legendFormat": "sent"},
        {"expr": "sum(rate(command_executed_total[5m]))", "legendFormat": "executed"},
        {"expr": "sum(rate(command_failure_total[5m]))", "legendFormat": "failed"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Command Lag p95 (seconds)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(command_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Stream Start / Failure",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(rate(stream_start_total[5m]))", "legendFormat": "starts"},
        {"expr": "sum(rate(stream_failure_total[5m]))", "legendFormat": "failures"}
      ]
    },
    {
      "type": "timeseries",
      "title": "ICE Failures",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum(rate(webrtc_ice_failures_total[5m]))", "legendFormat": "ice failures"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Heartbeat Freshness (max lag s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "device_heartbeat_freshness_max_lag_seconds", "legendFormat": "max lag"}
      ]
    },
    {
      "type": "timeseries",
      "title": "STOMP Sessions",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum(rate(stomp_sessions_connected_total[5m]))", "legendFormat": "connects"},
        {"expr": "sum(rate(stomp_sessions_disconnected_total[5m]))", "legendFormat": "disconnects"}
      ]
    }
  ]
}

# Root environment template — copy to .env and fill in local-only values.
# Never commit .env. Rotate any secret that was ever hardcoded in git history.

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=pcp
POSTGRES_PASSWORD=changeme-local-postgres-password
RABBITMQ_USER=pcp
RABBITMQ_PASSWORD=changeme-local-rabbitmq-password
MINIO_ROOT_USER=changeme-minio-user
MINIO_ROOT_PASSWORD=changeme-local-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-local-grafana-password

# --- Backend API ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parental_control
SPRING_DATASOURCE_USERNAME=pcp
SPRING_DATASOURCE_PASSWORD=changeme-local-postgres-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=changeme-local-jwt-secret-minimum-32-characters-long
APP_ENCRYPTION_KEY=changeme-local-encryption-key-32chars
APP_ENCRYPTION_ENABLED=false
HMAC_REQUIRED=false
TURN_SECRET=changeme-local-turn-secret-32chars-minimum
TURN_EXTERNAL_HOST=127.0.0.1
TAMPER_MASTER_PIN_ENABLED=false
TAMPER_MASTER_PIN=
METRICS_SCRAPE_TOKEN=

# --- Billing (server-side only — never expose in mobile apps) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_FAMILY=
BILLING_ENFORCEMENT=false

# --- Push / integrity (server-side only) ---
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=backend/secrets/firebase-service-account.json
FCM_SERVER_KEY=
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=
GOOGLE_CLOUD_ACCESS_TOKEN=

# --- Optional dev automation (parent app — never use in production builds) ---
DEV_AUTO_LOGIN=false
DEV_AUTO_EMAIL=
DEV_AUTO_PASSWORD=

# --- Child app build-time (local dev tamper bypass — leave empty for release) ---
TAMPER_MASTER_PIN=

# --- Mobile API endpoints (public-safe URLs only) ---
API_BASE_URL=http://127.0.0.1:8080
WS_BASE_URL=http://127.0.0.1:8080/ws
WS_NATIVE_URL=ws://127.0.0.1:8080/ws-native
DEV_LAN_HOST=192.168.1.5
ENABLE_SSL_PINNING=false

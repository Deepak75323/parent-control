<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">api.parentalcontrol.local</domain>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">REPLACE_WITH_BASE64_SPKI_PIN=</pin>
        </pin-set>
    </domain-config>
</network-security-config>

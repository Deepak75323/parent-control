# Parent app environment template — copy to parent/.env
# Only public-safe / local-dev values belong here. Never put Stripe/JWT secrets.

API_BASE_URL=http://10.0.2.2:8080
WS_BASE_URL=http://10.0.2.2:8080/ws
WS_NATIVE_URL=ws://10.0.2.2:8080/ws-native
ENABLE_SSL_PINNING=false

# API payload AES-CBC (same values as backend API_PAYLOAD_ENCRYPTION_*). Leave empty to disable.
API_PAYLOAD_ENCRYPTION_KEY=
API_PAYLOAD_ENCRYPTION_IV=

# Dev-only auto-login (never enable in production builds)
DEV_AUTO_LOGIN=false
DEV_AUTO_EMAIL=
DEV_AUTO_PASSWORD=

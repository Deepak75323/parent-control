# Parent app environment template — copy to parent-app/.env
# Only public-safe values belong here (API URLs). Never put Stripe secret keys or JWT secrets.

API_BASE_URL=http://127.0.0.1:8080
WS_BASE_URL=http://127.0.0.1:8080/ws
WS_NATIVE_URL=ws://127.0.0.1:8080/ws-native
ENABLE_SSL_PINNING=false

# Dev-only auto-login (never enable in production builds)
DEV_AUTO_LOGIN=false
DEV_AUTO_EMAIL=
DEV_AUTO_PASSWORD=

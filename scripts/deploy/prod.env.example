# Production credentials template — copy to backend/.env and fill before prod validation.
# Never commit real values. See docs/PRE-DEPLOYMENT-CHECKLIST.md
#
# Generate secrets: openssl rand -base64 32
# Stripe: use TEST keys (sk_test_...) until go-live.

SPRING_PROFILES_ACTIVE=prod

# Prod validator requires sslmode=require. Local Podman Postgres has no TLS —
# use Neon free Postgres, or run on your staging VPS.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/parental_control?sslmode=require
SPRING_DATASOURCE_USERNAME=pcp
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379

JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_BYTES_LONG
APP_ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES

CORS_ALLOWED_ORIGINS=https://api.yourdomain.com
WEBSOCKET_ALLOWED_ORIGINS=https://api.yourdomain.com

TURN_SECRET=CHANGE_ME_TURN_SECRET_MIN_32_BYTES
TURN_EXTERNAL_HOST=api.yourdomain.com

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=noreply@yourdomain.com
PASSWORD_RESET_URL_BASE=https://api.yourdomain.com/reset-password
EMAIL_VERIFICATION_URL_BASE=https://api.yourdomain.com/verify-email

STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STANDARD=price_test_CHANGE_ME
STRIPE_PRICE_FAMILY=price_test_CHANGE_ME
CHECKOUT_SUCCESS_URL=https://api.yourdomain.com/billing/success
CHECKOUT_CANCEL_URL=https://api.yourdomain.com/billing/cancel
BILLING_ENFORCEMENT=true

FCM_ENABLED=true
FCM_SERVICE_ACCOUNT_FILE=backend/secrets/firebase-service-account.json

PLAY_INTEGRITY_REQUIRED=true
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=backend/secrets/play-integrity-service-account.json

KAFKA_ENABLED=false
STOMP_RELAY_ENABLED=false
STOMP_CLUSTER_MODE=redis
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_PROMETHEUS_PUBLIC=false

TAMPER_MASTER_PIN=
TAMPER_MASTER_PIN_ENABLED=false
ADMIN_ENDPOINTS_ENABLED=false

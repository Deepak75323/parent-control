# Oracle Cloud VM retry launcher — copy to oracle.env and fill in values.
# Never commit oracle.env (adds secrets/OCIDs). Get OCIDs: ./scripts/deploy/oracle-discover-ocids.sh

# Region must match your tenancy home region (e.g. ap-mumbai-1).
OCI_REGION=ap-mumbai-1

# Tenancy OCID (Console → Profile → Tenancy).
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaa...

# Compartment where the instance will be created (usually root).
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaa...

# Public subnet OCID (VCN → Subnets → your public subnet).
# Regional subnets work across all ADs in Mumbai.
OCI_SUBNET_OCID=ocid1.subnet.oc1..aaaa...

# Ubuntu 22.04 aarch64 image for VM.Standard.A1.Flex (see discover script).
OCI_IMAGE_OCID=ocid1.image.oc1..aaaa...

# Optional: attach this reserved IP after the instance is RUNNING.
# OCI_RESERVED_PUBLIC_IP_OCID=ocid1.publicip.oc1..aaaa...

INSTANCE_DISPLAY_NAME=pcp-server
SHAPE=VM.Standard.A1.Flex
OCPUS=1
MEMORY_GB=6
BOOT_VOLUME_GB=50

# SSH public key used at launch (generate: ssh-keygen -t ed25519 -f ~/.ssh/pcp-oracle -N "")
SSH_PUBLIC_KEY_FILE=${HOME}/.ssh/pcp-oracle.pub

# Comma-separated AD names to rotate (discover script prints yours).
AVAILABILITY_DOMAINS=AD-1,AD-2,AD-3

# Wait between attempts when all ADs are out of capacity.
RETRY_INTERVAL_SECONDS=120

# 0 = retry until success (Ctrl+C to stop). Otherwise stop after N launch attempts.
MAX_ATTEMPTS=0
